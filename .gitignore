# --- Build artifacts ---
foundation
solver
tools/gen/gen
tools/bound/bound
tools/ref/solvers/refsolve
*.o
*.a
*.dSYM/

# --- Instructor-only material (NEVER commit to the student repo) ---
# The generator and the bound tool ARE shipped -- students need them to make
# practice instances with a bound. What stays behind: the hidden seed and its
# instances, the reference solver (a complete implementation of exactly the
# techniques the assignment asks students to find), the reference cuts, and
# the design notes.
docs/
tools/manifest/hidden.json
instances_hidden/
tools/ref/solvers/
tools/ref/cuts/
# The scoreboard Worker. src/validate.js IS the list of integrity checks;
# shipping it would hand students the exact checks to defeat.
scoreboard/

# --- Scored tier (distributed via GitHub Releases, not git) ---
# Only the dev_* graphs and every .meta.json are committed.
instances/*.mc
!instances/dev_*.mc
instances/*.gz

# --- Per-student / local work ---
solver.cpp
result.json
cuts/
*.cut
!samples/*.cut

# --- Tooling ---
.claude/
.vscode/
.idea/
__pycache__/
*.pyc

# --- OS junk ---
.DS_Store
Thumbs.db
